SEMA_CORE_URL="http://127.0.0.1:4310"
# Only for the one-time set-up script (npm run sema:core:bootstrap), which registers Resource's capabilities with Core.
# Resource proves who it is with this key and secret only to register its own signing key; after that it signs.
# The same key and secret must be in Core's SEMA_APPLICATION_CLIENTS_JSON, with a Foundation Access grant for
# core.capabilities.register.
# SEMA_RESOURCE_CORE_APPLICATION_KEY=sema.foundation.resource
# SEMA_RESOURCE_CORE_APPLICATION_SECRET=
# Optional: Core's folder (default SEMA-Core beside SEMA-Foundation), and where Resource keeps its private key
# (default keys/resource-key.dpapi on Windows, keys/resource-key.pem elsewhere). Never commit or copy the key.
# SEMA_CORE_DIRECTORY=
# SEMA_RESOURCE_KEY_FILE=
SEMA_RESOURCE_URL="http://127.0.0.1:4330"
SEMA_RESOURCE_STORE="./data"
# Set a long random value before any non-development use. Do not place this in an application repository.
SEMA_RESOURCE_ADMIN_KEY="replace-this-before-use"
SEMA_FOUNDATION_ACCESS_URL="http://127.0.0.1:4340"
# Same private policy key used by Foundation Access; do not reuse the resource admin key.
SEMA_POLICY_KEY="replace-with-the-Foundation-Access-policy-key"
