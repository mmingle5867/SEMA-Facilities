SEMA_FOUNDATION_ACCESS_PORT=4340
SEMA_FOUNDATION_ACCESS_HOSTNAME=127.0.0.1
SEMA_FOUNDATION_ACCESS_DATA_DIR=./data
SEMA_FOUNDATION_ACCESS_ADMIN_KEY=replace-with-a-strong-local-admin-key
SEMA_FOUNDATION_ACCESS_BOOTSTRAP_KEY=replace-with-a-one-time-bootstrap-key
