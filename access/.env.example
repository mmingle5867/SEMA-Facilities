SEMA_FOUNDATION_ACCESS_PORT=4340
SEMA_FOUNDATION_ACCESS_HOSTNAME=127.0.0.1
SEMA_FOUNDATION_ACCESS_DATA_DIR=./data
SEMA_FOUNDATION_ACCESS_ADMIN_KEY=replace-with-a-strong-local-admin-key
SEMA_FOUNDATION_ACCESS_BOOTSTRAP_KEY=replace-with-a-one-time-bootstrap-key
SEMA_CORE_URL=http://127.0.0.1:4310
# Optional: where Core's folder is, so Access can sign its requests to Core with Core's shared client code.
# Default: SEMA-Core beside the SEMA-Foundation folder.
# SEMA_CORE_DIRECTORY=
# Optional: where Access keeps its own private key for signing. Made on the first start.
# Default keys/access-key.dpapi (Windows, encrypted by Windows for this account) or keys/access-key.pem elsewhere.
# Never commit it or copy it to another machine.
# SEMA_FOUNDATION_ACCESS_KEY_FILE=
SEMA_POLICY_KEY=replace-with-a-different-strong-policy-key
SEMA_APPLICATION_KEY=sema.foundation.access
SEMA_APPLICATION_SECRET=replace-with-the-foundation-access-application-secret
SEMA_AUTH_SESSION_KEY=replace-with-a-unique-32-byte-or-longer-session-signing-secret
SEMA_AUTH_SESSION_TTL_MINUTES=480
